# ===================================================================
# MGIT PYQ Hub - Strict .gitignore Security & Hygiene Configuration
# ===================================================================

# Environment files & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.p12
credentials.json
service-account*.json
token.json

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Editor & IDE Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/
.pnpm-store

# Next.js Build Output & Cache
.next/
out/
build/
dist/

# Local OCR sources and generated data
.cache/
__pycache__/
*.py[cod]

# Large Binary Files & Temporary Processing Output
# Note: Source PDFs reside in Google Drive; do not store mass PDFs in GitHub
*.pdf
*.zip
*.tar.gz
*.iso
temp/
tmp/
*.tmp
logs/
*.log

# Vercel & Deployment
.vercel

.vercel

# Python cache files
__pycache__/
*.py[cod]

