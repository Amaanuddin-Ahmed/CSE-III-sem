# -------------------------------------------------------------------
# Supabase Configuration
# Dashboard: https://supabase.com/dashboard/project/nnqhtpuylejrahgfklzw
# -------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://nnqhtpuylejrahgfklzw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service Role Key (Server-side ONLY - NEVER expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# -------------------------------------------------------------------
# Google Gemini API
# Management: https://aistudio.google.com/app/apikey
# Server-side ONLY: Used for explanation and ingestion OCR
# -------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------
# Google Drive Configuration
# Root Folder: SEM 3 (1v_S2vjhz1mAkgfUk1WHkxIcyEMS_RlNr)
